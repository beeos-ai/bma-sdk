{
  "name": "@beeos-ai/bma-sdk",
  "version": "1.0.1",
  "description": "TypeScript client for the BMA REST API and the BMA extensions to the Anthropic Managed Agents API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeos-ai/bma-sdk.git",
    "directory": "typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./facade-extensions": {
      "types": "./dist/facade-extensions.d.ts",
      "import": "./dist/facade-extensions.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-typescript ../.build/rest.openapi.ts.yaml --default-non-nullable=false -o src/generated/rest.ts && openapi-typescript ../.build/facade-extensions.openapi.ts.yaml --default-non-nullable=false -o src/generated/facade-extensions.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "expect-type": "1.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
